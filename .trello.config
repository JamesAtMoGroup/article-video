# Trello 非機密設定（可進 git）。機密的 KEY/TOKEN 放 .trello.local。
# 腳本會用以下「看板名 + 清單名」自動解析出 List ID，你不必手動查 ID。
TRELLO_BOARD_NAME=產品部專區
TRELLO_LIST_NAME=每日AI知識庫

# Google Drive 內容資料夾（協作者實際存取的地方）。
# 腳本會用 rclone 在這個母資料夾底下找當天子夾 ai-knowledge-YYYY-MM-DD，
# 把卡片深連到當天那一夾；找不到就退回母資料夾連結。
DRIVE_REMOTE=gdrive
DRIVE_FOLDER_ID=1zICXqtO2RSEoKz34CDTsnPo8fQotA4On

# 卡片自動指派的負責人（Trello member id）。william165 = william。
# 建卡時自動 assign；對既有卡片若尚未指派也會補上。
TRELLO_MEMBER_ID=6a1eaad0c27b0580d31e92b5
